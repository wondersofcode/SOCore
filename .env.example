# SOCore — environment variables
# Bu faylı kopyalayıb .env adlandır, sonra dəyərləri doldur:
#   cp .env.example .env

# ===== MISP (Threat Intel) =====
MISP_URL=https://localhost:8443
MISP_API_KEY=                      # 🔴 TODO-DOLDUR: MISP admin panel -> Global Actions > My Profile > Auth Keys
MISP_VERIFY_SSL=false

# ===== Cortex (Threat Intel Analyzers) =====
CORTEX_URL=http://localhost:9001
CORTEX_API_KEY=                    # 🔴 TODO-DOLDUR: Cortex admin panel -> Users -> yeni API key yarat

# ===== TheHive (SOAR case management) =====
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=                   # 🔴 TODO-DOLDUR: TheHive admin panel -> Organisation > Users > API Key

# ===== Shuffle (SOAR automation/workflow) =====
SHUFFLE_URL=http://localhost:3001
SHUFFLE_API_KEY=                   # 🔴 TODO-DOLDUR: Shuffle admin panel -> Settings > API keys

# ===== Slack =====
SLACK_WEBHOOK_URL=                 # 🔴 TODO-DOLDUR: api.slack.com/apps -> Incoming Webhooks

# ===== Threat Intel enrichment =====
VIRUSTOTAL_API_KEY=                # 🔴 TODO-DOLDUR: virustotal.com hesabı -> Profile -> API Key
ABUSEIPDB_API_KEY=                 # 🔴 TODO-DOLDUR: abuseipdb.com hesabı -> Account -> API

# ===== Firewall blocker safety switch =====
# true = heç bir real dəyişiklik edilmir, sadəcə loglanır (tövsiyə olunan defolt)
FIREWALL_DRY_RUN=true              # 🔴 TODO-DOLDUR: real block lazım olsa DİQQƏTLƏ false et
