# 🔴 TODO-DOLDUR: Supabase-in "Direct connection string"-i (Settings → Database)
# Format: postgresql://postgres:PAROL@db.xxxx.supabase.co:5432/postgres
# Bu olmadan backend işə düşmür (alerts/cases persistent saxlanılmır).
DATABASE_URL=

# 🔴 TODO-DOLDUR: Supabase layihənin base URL-i (Settings → API → Project URL)
# Format: https://xxxx.supabase.co — JWT-ləri doğrulamaq üçün istifadə olunur.
# Bu olmadan HƏR authenticated endpoint 500 qaytarır (login işləmir).
SUPABASE_URL=

# 🔴 TODO-DOLDUR (OPSIONAL): özün deploy edəndə VM-inin public IP/host-u.
# GET /api/health-in "Open tool" linklərini (Wazuh dashboard, MISP, Cortex,
# Shuffle) qurmaq üçün istifadə olunur. Boş qalsa demo VM-in IP-sinə
# defolt olur — self-host edirsənsə mütləq öz IP-nlə əvəz et.
PUBLIC_HOST=

# 🔴 TODO-DOLDUR: Groq Console-dan aldığın API key
# console.groq.com/keys → Create API Key. Boş qalsa backend mock izahla işləyir.
GROQ_API_KEY=

# 🔴 TODO-DOLDUR: Slack Incoming Webhook URL (Sprint 1-də yaratdığın)
# Boş qalsa Slack bildirişləri ötürülür (skip), sistem yenə işləyir.
SLACK_WEBHOOK_URL=

# 🔴 TODO-DOLDUR: MISP admin panelindən (My Profile → Auth keys) aldığın key
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=false

# 🔴 TODO-DOLDUR: Cortex admin panelindən (Users → Create API Key) aldığın key
CORTEX_URL=
CORTEX_API_KEY=

# 🔴 TODO-DOLDUR (OPSIONAL): Shuffle-da qurduğun workflow-un Webhook Trigger
# node-unun verdiyi URL (Shuffle-ın öz login URL-i DEYİL). Playbook qurmamısansa
# boş saxla — yüksək riskli alertlər sadəcə Shuffle-a göndərilmir, hər şey
# başqa cür normal işləyir.
SHUFFLE_WEBHOOK_URL=

# ── Approve & Run response execution ────────────────────────────────────────
# Real "Block IP" actions run `fail2ban-client set <jail> banip <ip>` on this host.
# 🔴 SOCORE_PROTECTED_IPS: comma-separated IPs/CIDRs that must NEVER be blocked
# (put every analyst's public IP and this VM's public IP here). Private,
# loopback and link-local ranges are always refused, and so is PUBLIC_HOST and
# the approving analyst's own IP.
SOCORE_PROTECTED_IPS=
SOCORE_FAIL2BAN_JAIL=sshd
# "true" = run via `sudo -n` (needs the sudoers rule in README). Set "false" if the backend runs as root.
SOCORE_FAIL2BAN_SUDO=true
# Optional: when set, POST /api/ingest requires header X-SOCore-Token with this value
# (the Wazuh integration script sends it from its own SOCORE_INGEST_TOKEN env var).
SOCORE_INGEST_TOKEN=
